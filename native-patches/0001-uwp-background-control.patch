diff --git a/core/src/dealer/uwp_transport.rs b/core/src/dealer/uwp_transport.rs
new file mode 100644
index 0000000..19ad8d2
--- /dev/null
+++ b/core/src/dealer/uwp_transport.rs
@@ -0,0 +1,111 @@
+//! Optional host-owned WinRT WebSocket transport. Dealer framing, credentials,
+//! session ownership and protocol dispatch remain in Rust.
+use super::*;
+use std::{collections::HashMap, ffi::CString, sync::{OnceLock, RwLock, atomic::AtomicU64}};
+use tokio::sync::oneshot;
+
+pub type OpenCallback = extern "C" fn(u64, *const std::ffi::c_char) -> bool;
+pub type SendCallback = extern "C" fn(u64, *const u8, usize) -> bool;
+pub type CloseCallback = extern "C" fn(u64);
+pub type ActivityCallback = extern "C" fn(u64, u32, bool);
+
+#[derive(Clone, Copy)]
+pub struct Callbacks { pub open: OpenCallback, pub send: SendCallback, pub close: CloseCallback, pub activity: ActivityCallback }
+static CALLBACKS: RwLock<Option<Callbacks>> = RwLock::new(None);
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+const MAX_FRAME_BYTES: usize = 2 * 1024 * 1024;
+struct Client {
+    ready: Option<oneshot::Sender<bool>>,
+    frames: mpsc::Sender<String>,
+}
+static CLIENTS: OnceLock<Mutex<HashMap<u64, Client>>> = OnceLock::new();
+fn clients() -> &'static Mutex<HashMap<u64, Client>> { CLIENTS.get_or_init(|| Mutex::new(HashMap::new())) }
+
+pub fn register(callbacks: Callbacks) { *CALLBACKS.write().expect("transport callback lock") = Some(callbacks); }
+pub fn is_registered() -> bool { CALLBACKS.read().expect("transport callback lock").is_some() }
+
+pub struct NetworkActivity { id: u64, kind: u32, callback: ActivityCallback }
+pub fn network_activity(id: u64, kind: u32) -> Option<NetworkActivity> {
+    let callbacks = *CALLBACKS.read().expect("transport callback lock");
+    callbacks.filter(|_| id != 0).map(|callbacks| {
+        (callbacks.activity)(id, kind, true);
+        NetworkActivity { id, kind, callback: callbacks.activity }
+    })
+}
+impl Drop for NetworkActivity { fn drop(&mut self) { (self.callback)(self.id, self.kind, false); } }
+
+/// kind: 0=closed/failed, 1=connected, 2=UTF-8 text. Buffer is copied before return.
+pub unsafe fn push(id: u64, kind: u32, data: *const u8, length: usize) -> bool {
+    let mut clients = clients().lock().expect("transport clients lock");
+    if kind == 0 { return clients.remove(&id).is_some(); }
+    let Some(client) = clients.get_mut(&id) else { return false; };
+    if kind == 1 { if let Some(ready) = client.ready.take() { return ready.send(true).is_ok(); } return true; }
+    if kind != 2 || data.is_null() || length > MAX_FRAME_BYTES { return false; }
+    let Ok(text) = std::str::from_utf8(unsafe { std::slice::from_raw_parts(data, length) }) else { return false; };
+    client.frames.try_send(text.to_owned()).is_ok()
+}
+
+struct Lease { id: u64, callbacks: Callbacks }
+impl Drop for Lease {
+    fn drop(&mut self) {
+        clients().lock().expect("transport clients lock").remove(&self.id);
+        (self.callbacks.close)(self.id);
+    }
+}
+
+pub(super) async fn connect(address: &Url, shared: &Arc<DealerShared>) -> WsResult<(JoinHandle<()>, JoinHandle<()>)> {
+    let callbacks = CALLBACKS.read().expect("transport callback lock").ok_or_else(|| Error::unavailable("UWP transport is not registered"))?;
+    let id = NEXT_ID.fetch_add(1, atomic::Ordering::Relaxed);
+    shared.uwp_id.store(id, atomic::Ordering::Release);
+    let (ready_tx, ready_rx) = oneshot::channel();
+    let (frame_tx, mut frame_rx) = mpsc::channel(16);
+    clients().lock().expect("transport clients lock").insert(id, Client { ready: Some(ready_tx), frames: frame_tx });
+    let lease = Arc::new(Lease { id, callbacks });
+    let url = CString::new(address.as_str()).map_err(|_| Error::invalid_argument("invalid dealer URL"))?;
+    if !(callbacks.open)(id, url.as_ptr()) { return Err(Error::unavailable("UWP transport rejected open")); }
+    select! {
+        () = shared.closed() => return Err(Error::cancelled("dealer closed during WinRT connection")),
+        result = tokio::time::timeout(Duration::from_secs(20), ready_rx) => {
+            if !matches!(result, Ok(Ok(true))) { return Err(Error::unavailable("UWP control-channel connection failed")); }
+        }
+    }
+    info!("Dealer WinRT control channel connected");
+    let (send_tx, mut send_rx) = mpsc::unbounded_channel::<WsMessage>();
+    let outgoing_shared = shared.clone();
+    let outgoing_lease = lease.clone();
+    let send_task = tokio::spawn(async move {
+        loop {
+            select! {
+                () = outgoing_shared.closed() => break,
+                msg = send_rx.recv() => match msg {
+                    Some(WsMessage::Text(text)) => {
+                        if !(callbacks.send)(id, text.as_ptr(), text.len()) { break; }
+                    }
+                    Some(WsMessage::Close(_)) | None => break,
+                    _ => (), // WinRT/CCT owns WebSocket ping/pong, not a second timer.
+                }
+            }
+        }
+        (callbacks.close)(id);
+        drop(outgoing_lease);
+    });
+    let incoming_shared = shared.clone();
+    let receive_task = tokio::spawn(async move {
+        loop {
+            select! {
+                () = incoming_shared.closed() => break,
+                text = frame_rx.recv() => match text {
+                    Some(text) => match serde_json::from_str(&text) {
+                        Ok(message) => incoming_shared.dispatch(message, &send_tx),
+                        Err(_) => warn!("Invalid Dealer frame from WinRT transport"),
+                    },
+                    None => break,
+                }
+            }
+        }
+        warn!("Dealer WinRT control channel ended");
+        let _ = send_tx.send(WsMessage::Close(None));
+        drop(lease);
+    });
+    Ok((send_task, receive_task))
+}
