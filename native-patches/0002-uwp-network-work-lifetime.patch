diff --git a/core/src/dealer/leased_stream.rs b/core/src/dealer/leased_stream.rs
new file mode 100644
index 0000000..34b1c10
--- /dev/null
+++ b/core/src/dealer/leased_stream.rs
@@ -0,0 +1,27 @@
+//! Hold a queued message's lease until its consumer polls again or drops.
+use futures_core::Stream;
+use std::task::Poll;
+
+pub(crate) fn retaining_map<S, F, L, T, G>(stream: S, mut map: F, mut lease: L)
+    -> impl Stream<Item = T> + Send
+where
+    S: Stream + Send,
+    F: FnMut(S::Item) -> T + Send,
+    L: FnMut(&S::Item) -> G + Send,
+    G: Send,
+{
+    let mut stream = Box::pin(stream);
+    let mut previous = None;
+    futures_util::stream::poll_fn(move |cx| {
+        // Also release on Pending, not only when another message arrives.
+        previous.take();
+        match stream.as_mut().poll_next(cx) {
+            Poll::Ready(Some(message)) => {
+                previous = Some(lease(&message));
+                Poll::Ready(Some(map(message)))
+            }
+            Poll::Ready(None) => Poll::Ready(None),
+            Poll::Pending => Poll::Pending,
+        }
+    })
+}
