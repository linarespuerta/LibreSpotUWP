<Page
    x:Class="LibreSpotUWP.Views.Win10_1709.HiFiPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#000000"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Storyboard x:Name="PortraitVinylStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PortraitVinylRotation" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:6" />
        </Storyboard>
        <Storyboard x:Name="LandscapeVinylStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LandscapeVinylRotation" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:6" />
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="Root" Background="#000000" Padding="20">
        <Grid x:Name="PortraitLayout" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MinHeight="48">
                <Button x:Name="BackButton" Width="48" Height="48" HorizontalAlignment="Left"
                        Background="Transparent" AutomationProperties.Name="Back" Click="BackButton_Click">
                    <SymbolIcon Symbol="Back" Foreground="#F1E9D8" />
                </Button>
                <TextBlock x:Name="PortraitStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="230" FontSize="14" Foreground="#D7A65B" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Width="48" Height="48" HorizontalAlignment="Right" Background="Transparent"
                        AutomationProperties.Name="More playback options">
                    <SymbolIcon Symbol="More" Foreground="#F1E9D8" />
                    <Button.Flyout>
                        <Flyout><StackPanel Width="180" Spacing="6">
                            <Button Content="Classic player" Click="ClassicButton_Click" />
                            <Button x:Name="PortraitArtistNavigation" Content="Open artist" Click="ArtistNavigation_Click" />
                            <Button x:Name="PortraitAlbumNavigation" Content="Open album" Click="AlbumNavigation_Click" />
                            <ToggleSwitch x:Name="PortraitLockScreenToggle" Header="Album art on lock screen"
                                          Toggled="LockScreenToggle_Toggled" />
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Text="Changes the wallpaper behind Windows music controls. The record spins only inside the app. Turning this off will not restore your old wallpaper." />
                        </StackPanel></Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Grid Grid.Row="1" MinHeight="120" Margin="0,8,0,12">
                <Image x:Name="PortraitArt" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       ImageFailed="Artwork_ImageFailed" />
                <SymbolIcon x:Name="PortraitPlaceholder" Symbol="MusicInfo" Width="72" Height="72"
                            Foreground="#655F55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,8,2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="PortraitVinylRotation" /></Grid.RenderTransform>
                    <Ellipse Fill="#101010" Stroke="#D7A65B" StrokeThickness="2" />
                    <Ellipse Margin="8" Stroke="#39332B" StrokeThickness="2" />
                    <Ellipse Margin="16" Stroke="#27231F" StrokeThickness="2" />
                    <Ellipse Margin="24" Fill="#D7A65B" />
                    <Ellipse Margin="35" Fill="#161616" />
                    <Ellipse Width="6" Height="6" Fill="#F1E9D8" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
                <TextBlock x:Name="PortraitTitle" FontSize="26" FontWeight="SemiBold" Foreground="#F1E9D8"
                           MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="PortraitArtist" FontSize="18" Foreground="#B8B1A4" MaxLines="1"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                <TextBlock x:Name="PortraitAlbum" FontSize="15" Foreground="#8D887F" MaxLines="1"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="PortraitElapsed" Foreground="#B8B1A4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="PortraitPosition" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="True"
                        AutomationProperties.Name="Track position" ValueChanged="Position_ValueChanged"
                        PointerPressed="Position_PointerPressed" PointerReleased="Position_PointerReleased"
                        PointerCaptureLost="Position_PointerCaptureLost" />
                <TextBlock x:Name="PortraitDuration" Grid.Column="2" Foreground="#B8B1A4" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <StackPanel Grid.Row="4" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Width="56" Height="56" Background="Transparent" AutomationProperties.Name="Previous track" Click="Previous_Click">
                        <SymbolIcon Symbol="Previous" Foreground="#F1E9D8" />
                    </Button>
                    <Button Width="68" Height="68" Margin="16,0" Background="#D7A65B" AutomationProperties.Name="Play or pause" Click="PlayPause_Click">
                        <SymbolIcon x:Name="PortraitPlayIcon" Symbol="Play" Foreground="#000000" />
                    </Button>
                    <Button Width="56" Height="56" Background="Transparent" AutomationProperties.Name="Next track" Click="Next_Click">
                        <SymbolIcon Symbol="Next" Foreground="#F1E9D8" />
                    </Button>
                </StackPanel>
                <Grid Margin="0,4,0,0" MinHeight="48">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE992;" FontFamily="Segoe MDL2 Assets" Foreground="#B8B1A4" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider x:Name="PortraitVolume" Grid.Column="1" Minimum="0" Maximum="100" AutomationProperties.Name="Volume"
                            ValueChanged="Volume_ValueChanged" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid x:Name="LandscapeLayout" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="4,20,20,20">
                <Image x:Name="LandscapeArt" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       ImageFailed="Artwork_ImageFailed" />
                <SymbolIcon x:Name="LandscapePlaceholder" Symbol="MusicInfo" Width="72" Height="72"
                            Foreground="#655F55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,8,2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="LandscapeVinylRotation" /></Grid.RenderTransform>
                    <Ellipse Fill="#101010" Stroke="#D7A65B" StrokeThickness="2" />
                    <Ellipse Margin="8" Stroke="#39332B" StrokeThickness="2" />
                    <Ellipse Margin="16" Stroke="#27231F" StrokeThickness="2" />
                    <Ellipse Margin="24" Fill="#D7A65B" />
                    <Ellipse Margin="35" Fill="#161616" />
                    <Ellipse Width="6" Height="6" Fill="#F1E9D8" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
            </Grid>
            <Grid Grid.Column="1" Margin="0,4,4,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" MinHeight="48">
                    <Button Width="48" Height="48" HorizontalAlignment="Left" Background="Transparent"
                            AutomationProperties.Name="Back" Click="BackButton_Click"><SymbolIcon Symbol="Back" Foreground="#F1E9D8" /></Button>
                    <TextBlock x:Name="LandscapeStatus" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"
                               FontSize="14" Foreground="#D7A65B" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Width="48" Height="48" HorizontalAlignment="Right" Background="Transparent"
                            AutomationProperties.Name="More playback options"><SymbolIcon Symbol="More" Foreground="#F1E9D8" />
                        <Button.Flyout>
                            <Flyout><StackPanel Width="180" Spacing="6">
                                <Button Content="Classic player" Click="ClassicButton_Click" />
                                <Button x:Name="LandscapeArtistNavigation" Content="Open artist" Click="ArtistNavigation_Click" />
                                <Button x:Name="LandscapeAlbumNavigation" Content="Open album" Click="AlbumNavigation_Click" />
                                <ToggleSwitch x:Name="LandscapeLockScreenToggle" Header="Album art on lock screen"
                                              Toggled="LockScreenToggle_Toggled" />
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="Changes the wallpaper behind Windows music controls. The record spins only inside the app. Turning this off will not restore your old wallpaper." />
                            </StackPanel></Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="LandscapeTitle" FontSize="26" FontWeight="SemiBold" Foreground="#F1E9D8"
                               MaxLines="2" TextWrapping="Wrap" />
                    <TextBlock x:Name="LandscapeArtist" FontSize="18" Foreground="#B8B1A4" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LandscapeAlbum" FontSize="15" Foreground="#8D887F" MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LandscapeElapsed" Foreground="#B8B1A4" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="LandscapePosition" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="True"
                            AutomationProperties.Name="Track position" ValueChanged="Position_ValueChanged"
                            PointerPressed="Position_PointerPressed" PointerReleased="Position_PointerReleased"
                            PointerCaptureLost="Position_PointerCaptureLost" />
                    <TextBlock x:Name="LandscapeDuration" Grid.Column="2" Foreground="#B8B1A4" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Width="56" Height="56" Background="Transparent" AutomationProperties.Name="Previous track" Click="Previous_Click">
                        <SymbolIcon Symbol="Previous" Foreground="#F1E9D8" />
                    </Button>
                    <Button Width="68" Height="68" Margin="16,0" Background="#D7A65B" AutomationProperties.Name="Play or pause" Click="PlayPause_Click">
                        <SymbolIcon x:Name="LandscapePlayIcon" Symbol="Play" Foreground="#000000" />
                    </Button>
                    <Button Width="56" Height="56" Background="Transparent" AutomationProperties.Name="Next track" Click="Next_Click">
                        <SymbolIcon Symbol="Next" Foreground="#F1E9D8" />
                    </Button>
                </StackPanel>
                <Grid Grid.Row="4" MinHeight="48">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE992;" FontFamily="Segoe MDL2 Assets" Foreground="#B8B1A4" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider x:Name="LandscapeVolume" Grid.Column="1" Minimum="0" Maximum="100" AutomationProperties.Name="Volume"
                            ValueChanged="Volume_ValueChanged" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
